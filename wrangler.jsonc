{
  "name": "sevenpro-entertainment",
  "main": "./worker.ts",
  "compatibility_date": "2025-12-01",
  "vars": {
    "BOOKING_FROM_EMAIL": "Sevenpro Entertainment <onboarding@resend.dev>",
    "BOOKING_TO_EMAIL": "sevenproentertainment.web@gmail.com"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
